FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements-injury.txt .
RUN pip install --no-cache-dir -r requirements-injury.txt

# Copy application files
COPY injury_scraper.py .
COPY injury_api.py .

# Create directories
RUN mkdir -p /app/processed /app/logs

# Expose port
EXPOSE 8002

# Run with gunicorn
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8002", "--timeout", "120", "injury_api:app"]
