#!/usr/bin/env python3
"""
Claude Code Message Response Hook

모든 Claude 응답을 자동으로 로그 파일에 저장
- 일자별 파일: logs/conversation_YYYY-MM-DD.jsonl
- JSONL 포맷 (한 줄에 하나의 JSON)
- 타임스탬프 포함
- 오류 발생 시에도 계속 동작
"""

import sys
import json
from datetime import datetime
from pathlib import Path

def log_message(message_data):
    """메시지를 일자별 로그 파일에 저장"""
    try:
        # 프로젝트 루트 찾기 (.claude 디렉토리 기준)
        script_path = Path(__file__).resolve()
        project_root = script_path.parent.parent.parent

        # 로그 디렉토리
        log_dir = project_root / "logs"
        log_dir.mkdir(exist_ok=True)

        # 일자별 파일명 (프로젝트 구분)
        today = datetime.now().strftime("%Y-%m-%d")
        log_file = log_dir / f"conversation_nba_{today}.jsonl"

        # 로그 엔트리 생성 (프로젝트 메타데이터 추가)
        log_entry = {
            "timestamp": datetime.now().isoformat(),
            "project": "nba",
            "type": "assistant_response",
            "content": message_data
        }

        # JSONL 형식으로 append
        with open(log_file, 'a', encoding='utf-8') as f:
            f.write(json.dumps(log_entry, ensure_ascii=False) + '\n')

        # 성공 메시지 (stderr로 출력, stdout은 hook 결과용)
        print(f"[Hook] Logged to {log_file}", file=sys.stderr)

    except Exception as e:
        # 오류 발생해도 hook 실패하지 않음
        print(f"[Hook] Error logging message: {e}", file=sys.stderr)

def main():
    """Hook 진입점"""
    try:
        # stdin으로 메시지 데이터 받기
        input_data = sys.stdin.read()

        if input_data:
            message_data = json.loads(input_data)
            log_message(message_data)

        # Hook은 항상 성공 (빈 출력)
        print("")

    except Exception as e:
        print(f"[Hook] Fatal error: {e}", file=sys.stderr)
        # 빈 출력으로 hook 성공 처리
        print("")

if __name__ == "__main__":
    main()
