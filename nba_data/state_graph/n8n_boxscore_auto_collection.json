            "index": 0
          }
        ]
      ]
    },
    "Crawl Box Scores": {
      "main": [
        [
          {
            "node": "Import to Neo4j",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Import to Neo4j": {
      "main": [
        [
          {
            "node": "Success Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success Message": {
      "main": [
        [
          {
            "node": "Notify (Optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
