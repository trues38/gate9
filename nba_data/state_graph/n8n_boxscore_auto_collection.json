{
  "name": "NBA Box Score Auto Collection",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "name": "Daily 02:00 Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "notes": "매일 새벽 2시 실행\n(전날 NBA 경기 종료 후)"
    },
    {
      "parameters": {
        "jsCode": "// 어제 날짜 계산 (YYYYMMDD 형식)\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\n\nconst year = yesterday.getFullYear();\nconst month = String(yesterday.getMonth() + 1).padStart(2, '0');\nconst day = String(yesterday.getDate()).padStart(2, '0');\n\nconst dateStr = `${year}${month}${day}`;\nconst dateDisplay = `${year}-${month}-${day}`;\n\nreturn [{\n  json: {\n    date_arg: dateStr,\n    date_display: dateDisplay,\n    year: year,\n    month: month,\n    day: day\n  }\n}];"
      },
      "name": "Calculate Yesterday",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300],
      "notes": "어제 날짜 계산\n예: 20251225"
    },
    {
      "parameters": {
        "command": "cd /Users/js/g9/nba_data/state_graph && /Users/js/g9/.venv/bin/python3 crawl_current_season_boxscores.py",
        "additionalFields": {}
      },
      "name": "Crawl Box Scores",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300],
      "notes": "ESPN API에서 Box Score 수집\n\n스크립트:\n- crawl_current_season_boxscores.py\n- 출력: player_boxscores_2025_26/"
    },
    {
      "parameters": {
        "command": "cd /Users/js/g9/nba_data/state_graph && /Users/js/g9/.venv/bin/python3 import_player_boxscores.py",
        "additionalFields": {}
      },
      "name": "Import to Neo4j",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 300],
      "notes": "Neo4j에 Box Score 임포트\n\n스크립트:\n- import_player_boxscores.py\n- 대상: bolt://localhost:7687"
    },
    {
      "parameters": {
        "jsCode": "const dateDisplay = $node[\"Calculate Yesterday\"].json.date_display;\nconst crawlOutput = $input.item.json;\n\nreturn [{\n  json: {\n    status: 'success',\n    date: dateDisplay,\n    message: `✅ Box Score 수집 완료: ${dateDisplay}`,\n    timestamp: new Date().toISOString(),\n    crawl_output: crawlOutput\n  }\n}];"
      },
      "name": "Success Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300],
      "notes": "성공 메시지 생성"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/notify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"boxscore_updated\",\n  \"date\": \"{{ $json.date }}\",\n  \"message\": \"{{ $json.message }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Notify (Optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 300],
      "notes": "웹 알림 (선택사항)\n\n엔드포인트:\n- POST /api/notify\n- 슬랙/텔레그램 연동 가능",
      "continueOnFail": true
    }
  ],
  "connections": {
    "Daily 02:00 Trigger": {
      "main": [
        [
          {
            "node": "Calculate Yesterday",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Yesterday": {
      "main": [
        [
          {
